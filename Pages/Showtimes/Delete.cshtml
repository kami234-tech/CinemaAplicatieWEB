@page "{id:int}"
@model CinemaAplicatieWEB.Pages.Showtimes.DeleteModel

<h1>Delete Showtime</h1>

<div>
    <h4>Are you sure you want to delete this showtime?</h4>
    <dl class="row">
        <dt class="col-sm-2">Movie</dt>
        <dd class="col-sm-10">@Model.Showtime.Movie.Title</dd>

        <dt class="col-sm-2">Hall</dt>
        <dd class="col-sm-10">@Model.Showtime.Hall.Name</dd>

        <dt class="col-sm-2">Date & Time</dt>
        <dd class="col-sm-10">@Model.Showtime.DateTime?.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
