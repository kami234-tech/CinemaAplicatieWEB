@page
@model CinemaAplicatieWEB.Pages.Showtimes.IndexModel

@{
    ViewData["Title"] = "Showtimes";
}

<h1>Showtimes</h1>
@if (User.IsInRole("admin"))
{
    <p>
        <a asp-page="./Create" class="btn btn-primary">Create New Showtime</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Hall</th>
            <th>Date & Time</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var showtime in Model.Showtimes)
        {
            <tr>
                <td>@showtime.Movie.Title</td>
                <td>@showtime.Hall.Name</td>
                <td>@showtime.DateTime?.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@showtime.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@showtime.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
