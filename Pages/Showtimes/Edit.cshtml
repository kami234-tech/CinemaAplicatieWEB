@page "{id:int}"
@model CinemaAplicatieWEB.Pages.Showtimes.EditModel

<h1>Edit Showtime</h1>

<form method="post">
    <div class="form-group">
        <label for="MovieId">Movie</label>
        <select id="MovieId" name="Showtime.MovieId" class="form-control" asp-for="Showtime.MovieId" required>
            <option value="">-- Select a Movie --</option>
            @foreach (var movie in Model.Movies)
            {
                <option value="@movie.Id" selected="@((movie.Id == Model.Showtime.MovieId) ? "selected" : null)">@movie.Title</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="HallId">Hall</label>
        <select id="HallId" name="Showtime.HallId" class="form-control" asp-for="Showtime.HallId" required>
            <option value="">-- Select a Hall --</option>
            @foreach (var hall in Model.Halls)
            {
                <option value="@hall.Id" selected="@((hall.Id == Model.Showtime.HallId) ? "selected" : null)">@hall.Name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="DateTime">Date & Time</label>
        <input type="datetime-local" id="DateTime" name="Showtime.DateTime" class="form-control" asp-for="Showtime.DateTime" value="@Model.Showtime.DateTime?.ToString("yyyy-MM-ddTHH:mm")" required />
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
