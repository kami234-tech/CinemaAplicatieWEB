@page
@model CinemaAplicatieWEB.Pages.Halls.CreateModel

@{
    ViewData["Title"] = "Create Hall";
}

<h1>Create Hall</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Hall.Name" class="control-label"></label>
        <input asp-for="Hall.Name" class="form-control" />
        <span asp-validation-for="Hall.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Hall.Capacity" class="control-label"></label>
        <input asp-for="Hall.Capacity" class="form-control" type="number" />
        <span asp-validation-for="Hall.Capacity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Hall.Layout" class="control-label"></label>
        <input asp-for="Hall.Layout" class="form-control" />
        <span asp-validation-for="Hall.Layout" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Create Hall" class="btn btn-primary" />
    </div>
</form>

<a asp-page="./Index" class="btn btn-secondary">Back to List</a>
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://ajax.microsoft.com/ajax/jquery.validate/1.19.2/jquery.validate.min.js"></script>
    <script src="https://ajax.microsoft.com/ajax/jquery.validate.unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
}
