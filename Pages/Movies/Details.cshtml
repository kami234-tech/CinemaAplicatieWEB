@page "{id:int}"
@model CinemaAplicatieWEB.Pages.Movies.DetailsModel

@{
    ViewData["Title"] = "Movie Details";
}

<h1>Movie Details</h1>

<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Movie.Title</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Movie.Description</dd>

        <dt class="col-sm-2">Duration</dt>
        <dd class="col-sm-10">@Model.Movie.Duration minutes</dd>

        <dt class="col-sm-2">Genres</dt>
        <dd class="col-sm-10">@Model.Movie.Genres</dd>
    </dl>
</div>

<!-- Admin Role Check for Edit Button -->
@if (User.IsInRole("admin"))
{
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Movie.Id" class="btn btn-primary">Edit</a>
    </div>
}

<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>
