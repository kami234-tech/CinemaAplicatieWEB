@page
@model CinemaAplicatieWEB.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

<!-- Check if the user is an admin -->
@if (User.IsInRole("admin"))
{
    <p>
        <a asp-page="./Create" class="btn btn-primary">Create New Movie</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Duration</th>
            <th>Genres</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model.Movie)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Description</td>
                <td>@movie.Duration minutes</td>
                <td>@string.Join(", ", movie.Genres)</td>  <!-- Make sure you join genres if it's a list -->
                <td>
                    <!-- Check if the user is an admin before showing these buttons -->
                    @if (User.IsInRole("admin"))
                    {
                        <a asp-page="./Details" asp-route-id="@movie.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-page="./Edit" asp-route-id="@movie.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@movie.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                    else
                    {
                        <!-- Optionally, you could show different content for non-admin users, like viewing details -->
                        <a asp-page="./Details" asp-route-id="@movie.Id" class="btn btn-info btn-sm">Details</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
